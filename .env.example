# ScamShield Environment Variables
# Copy this file to .env and fill in values.

# ── Database ──────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/scamshield"

# ── Redis (optional; in-memory rate limiting otherwise) ───
REDIS_URL="redis://localhost:6379"

# ── Privacy ───────────────────────────────────────────────
# Salt for the HMAC-SHA256 message hash. Set a unique value in production.
MESSAGE_HASH_SALT="change-me-to-a-long-random-string"

# ── Anthropic (Claude) ────────────────────────────────────
ENABLE_AI_EXPLANATION="false"
ANTHROPIC_API_KEY="sk-ant-..."

# ── Sentry (optional) ─────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
LOG_LEVEL="info"
NODE_ENV="development"

# ── Docker Compose ────────────────────────────────────────
APP_DOMAIN="localhost"
POSTGRES_PASSWORD="change-me-in-production"
